# ═══════════════════════════════════════════════════════════════════════
#  Environment variables — copy to `.env` and fill in real values
#  لا ترفع ملف .env على git أو على الـ shared host repo
# ═══════════════════════════════════════════════════════════════════════

# Production mode flag — set to "production" on cPanel
NODE_ENV=production

# Port — على cPanel هتيجي تلقائياً من Passenger، سيبها فاضية أو 3000 محلياً
PORT=3000

# Session secret — أهم متغير. غيّره لـ random string طويل وحطه على cPanel
# يمكنك توليده بأمر:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-please

# Cookie secure — true لو الموقع يدعم HTTPS فقط (الافتراضي على cPanel)
# لو الموقع HTTP بس (نادراً) خلّيها false
COOKIE_SECURE=true
